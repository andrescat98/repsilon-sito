{
    "extends": "astro/tsconfigs/base",
    "include": [
        ".astro/types.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.astro"
    ],
    "exclude": [
        "dist"
    ],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "allowImportingTsExtensions": true
    }
}