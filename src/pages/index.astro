---
import Layout from '../layouts/Layout.astro';
import { releases, events } from '../data/data';
---

<Layout title="Home">
    <!-- HERO -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden">
        <!-- Sfondo animato — sostituisci con il tuo file video/gif/canvas -->

        <div class="fixed inset-0 z-0" id="bg-animated">
            <img src="/images/bg.jpg" alt="" class="w-full h-full object-cover" />
        </div>

        <!-- Overlay scuro -->
        <div class="absolute inset-0 z-10 bg-black/50"></div>

        <!-- Contenuto hero -->
        <div class="relative z-20 text-center px-6" id="hero-content">
            <h1 class="text-[clamp(5rem,20vw,18rem)] leading-none text-white opacity-0 animate-fadein" style="animation-delay: 0.5s; perspective: 700px;"><span id="hero-r" class="hero-r-letter">R</span>EPSILON</h1>
            <div class="w-24 h-px bg-accent mx-auto mt-8 opacity-0 animate-fadein" style="animation-delay: 0.8s;"></div>
        </div>

        <!-- Scroll indicator -->
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 opacity-0 animate-fadein" style="animation-delay: 1.2s;">
            <span class="text-xs tracking-widest text-white/50 uppercase">Scorri</span>
            <div class="w-px h-12 bg-linear-to-b from-white/50 to-transparent animate-bounce-slow"></div>
        </div>
    </section>

<!-- PROSSIMI EVENTI -->
<section class="w-full bg-black/80 relative z-10" style="padding-left: 3%; padding-right: 3%; padding-top: 2rem; padding-bottom: 5rem; min-height: 45vh;">
    <div class="flex items-end justify-between mb-16">
        <h2 class="text-6xl md:text-8xl text-white">LIVE</h2>
        <div class="w-32 h-px bg-accent mb-3"></div>
    </div>

    <div id="live-events" class="flex flex-col gap-0" data-events={JSON.stringify(events)}></div>
    <div class="border-t border-white/10"></div>

    <div id="past-events-section" style="margin-top: 3rem; display: none;">
        <h3 class="text-white/30 text-xs tracking-[0.4em] uppercase mb-6">Archivio eventi</h3>
        <div id="past-events" class="flex flex-col gap-0"></div>
    </div>

    <script type="module">
        const liveContainer = document.getElementById('live-events');
        const pastSection = document.getElementById('past-events-section');
        const pastContainer = document.getElementById('past-events');

        if (liveContainer && pastSection && pastContainer) {
            const eventsJson = liveContainer.dataset.events || '[]';
            const events = JSON.parse(eventsJson);
            const now = new Date();
            const future = events.filter(e => new Date(e.dateISO) >= now);
            const past = events.filter(e => new Date(e.dateISO) < now).slice(-5);

            const createUpcomingEvent = (event) => `
                <a href="${event.link}" target="_blank" class="group flex flex-col gap-2 py-7 border-t border-white/10 hover:border-accent/50 transition-all duration-300 hover:px-4">
                    <div class="flex items-baseline justify-between gap-4">
                        <span class="text-accent text-base font-mono tracking-widest shrink-0">${event.date}</span>
                        <span class="text-white text-xl md:text-2xl font-light group-hover:text-accent transition-colors text-right">${event.name}</span>
                    </div>
                    <div class="event-location-fit w-full whitespace-nowrap overflow-hidden text-white/40 uppercase font-light" style="font-size: clamp(0.8rem, 3vw, 2rem)">
                        ${event.location} · ${event.city}
                    </div>
                    <div class="flex justify-end mt-1">
                        <span class="text-[10px] md:text-xs tracking-widest uppercase text-accent border border-accent/50 md:text-white/40 md:border-white/15 group-hover:border-accent/50 group-hover:text-accent px-3 py-1.5 transition-all whitespace-nowrap">
                            Info e biglietti evento →
                        </span>
                    </div>
                </a>`;

            const createPastEvent = (event) => `
                <a href="${event.link}" target="_blank" class="group flex flex-col gap-1 py-4 border-t border-white/10 hover:border-white/15 transition-all duration-300 hover:px-4">
                    <div class="flex items-baseline justify-between gap-3">
                        <span class="text-white/25 text-[0.7rem] font-mono tracking-[0.3em] shrink-0">${event.date}</span>
                        <span class="text-white/30 text-base md:text-[1rem] font-light group-hover:text-white/50 transition-colors text-right">${event.name}</span>
                    </div>
                    <div class="event-location-fit w-full whitespace-nowrap overflow-hidden text-white/25 uppercase font-light" style="font-size: clamp(0.65rem, 2.2vw, 1.2rem)">
                        ${event.location} · ${event.city}
                    </div>
                    <div class="flex justify-end mt-1">
                        <span class="text-[8px] md:text-[9px] tracking-[0.4em] uppercase text-white/25 border border-white/10 group-hover:border-white/15 px-2 py-1 transition-all whitespace-nowrap">
                            Evento passato
                        </span>
                    </div>
                </a>`;

            liveContainer.innerHTML = future.length === 0
                ? '<p class="text-white/40 text-sm tracking-widest uppercase py-8">— Stay tuned per i prossimi concerti —</p>'
                : future.map(createUpcomingEvent).join('');

            if (past.length > 0) {
                pastContainer.innerHTML = past.map(createPastEvent).join('');
                pastSection.style.display = '';
            }
        }
    </script>
</section>
<!-- ALBUMS -->

<!-- PROSSIME USCITE -->
<section class="w-full bg-black/80 relative z-10" style="padding: 3rem 3% 5rem;">
    <div class="flex items-end justify-between mb-16">
        <h2 class="text-6xl md:text-8xl text-white">USCITE</h2>
        <div class="w-32 h-px bg-accent" style="margin-bottom: 1.5rem;"></div>
    </div>
    <div class="grid release-grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-15" style="padding: 1% 15% 0;">
        {releases.map((release) => (
            <div
                class="release-card group cursor-pointer relative"
                style="perspective: 1000px;"
                onclick={`window.location.href='${release.page}'`}
            >
                <!-- Custodia -->
                <div class="relative aspect-square overflow-hidden">
                    <img
                        src={release.cover}
                        alt={release.title}
                        class="w-full h-full object-cover opacity-100 group-hover:opacity-70 transition-opacity duration-500"
                        onerror="this.style.display='none'"
                    />
                    <div class="absolute inset-0 bg-linear-to-l from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-8 bg-linear-to-t from-black via-black/30 to-transparent">
                        <p class="text-accent text-xs tracking-[0.3em] uppercase mb-1">{release.type} — {release.date}</p>
                        <h3 class="text-white text-3xl md:text-4xl" style="font-family:'Bebas Neue',sans-serif;">{release.title}</h3>
                    </div>
                </div>

                <!-- Vinile che sporge a destra -->
                <div
                    class="vinyl-animation absolute top-[5%] -right-[4%] w-[90%] h-[90%] rounded-full transition-all duration-500 ease-out opacity-30 group-hover:opacity-100 group-hover:translate-x-8"
                    style="z-index: -1; background: radial-gradient(circle at 50% 50%, #2a2a2a 18%, #1a1a1a 19%, #222 45%, #111 46%, #1a1a1a 70%, #111 71%, #0a0a0a 100%); box-shadow: inset 0 0 30px rgba(0,0,0,0.8), -2px 0 15px rgba(0,0,0,0.5);"
                >
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[25%] h-[25%] rounded-full overflow-hidden" style="box-shadow: 0 0 8px rgba(0,0,0,0.9);">
                        <img src={release.cover} alt="" class="w-full h-full object-cover" onerror="this.style.display='none'" />
                    </div>
                </div>
            </div>
        ))}
    </div>
    <div class="release-bottom-spacer"></div>
</section>

<script>
    // Fit location · city text to full container width
    function fitEventLocations() {
        document.querySelectorAll<HTMLElement>('.event-location-fit').forEach(el => {
            el.style.fontSize = '16px';
            const scale = el.offsetWidth / el.scrollWidth;
            el.style.fontSize = (16 * scale * 0.98) + 'px';
        });
    }
    fitEventLocations();
    window.addEventListener('resize', fitEventLocations);

    const r = document.getElementById('hero-r') as HTMLElement | null;

    if (r) {
        const scheduleNextSpin = () => {
            // gira ogni 6-11 secondi in modo casuale
            const delay = 6000 + Math.random() * 5000;
            setTimeout(() => {
                doSpin(scheduleNextSpin);
            }, delay);
        };

        const doSpin = (callback?: () => void) => {
            r.style.animation = 'rSpin 0.9s cubic-bezier(0.4, 0, 0.2, 1) forwards';
            r.addEventListener('animationend', () => {
                r.style.animation = '';
                if (callback) callback();
            }, { once: true });
        };

        // aspetta che il fadein del titolo finisca (0.5s delay + 0.8s durata)
        // poi gira subito, poi inizia il ciclo periodico
        setTimeout(() => doSpin(scheduleNextSpin), 1400);
    }

    // Animazione del vinile su mobile quando la card è al centro della viewport
    const setupMobileVinylAnimation = () => {
        if (!window.matchMedia('(max-width: 768px)').matches) return;

        const cards = Array.from(document.querySelectorAll<HTMLElement>('.release-card'));
        if (cards.length === 0) return;

        const updateCenteredCard = () => {
            const viewportCenter = window.innerHeight / 2;
            let bestCard: HTMLElement | null = null;
            let bestDistance = Infinity;

            cards.forEach(card => {
                const rect = card.getBoundingClientRect();
                const cardCenter = rect.top + rect.height / 2;
                const distance = Math.abs(cardCenter - viewportCenter);
                if (distance < bestDistance) {
                    bestDistance = distance;
                    bestCard = card;
                }
            });

            const threshold = window.innerHeight * 0.35;
            cards.forEach(card => {
                card.classList.toggle('is-centered', card === bestCard && bestDistance < threshold);
            });
        };

        updateCenteredCard();

        let ticking = false;
        const onScrollOrResize = () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
                updateCenteredCard();
                ticking = false;
            });
        };

        window.addEventListener('scroll', onScrollOrResize, { passive: true });
        window.addEventListener('resize', onScrollOrResize);
    };

    const addMobileReleaseSpacer = () => {
        if (!window.matchMedia('(max-width: 768px)').matches) return;

        const releaseGrid = document.querySelector<HTMLElement>('.release-grid');
        if (!releaseGrid || document.querySelector('.release-end-spacer')) return;

        const spacer = document.createElement('div');
        spacer.className = 'release-end-spacer';
        spacer.innerHTML = '<p class="text-white/20 text-[0.75rem] uppercase tracking-[0.4em] text-center py-8">&nbsp;</p>';
        releaseGrid.insertAdjacentElement('afterend', spacer);
    };

    addMobileReleaseSpacer();
    setupMobileVinylAnimation();
</script>

</Layout>

<style>
    @keyframes fadein {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fadein {
        animation: fadein 0.8s ease forwards;
    }

    .hero-r-letter {
        display: inline-block;
    }

    #bg-animated {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        transform: translateZ(0);
        backface-visibility: hidden;
        will-change: transform;
        pointer-events: none;
    }

    #bg-animated img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transform: translateZ(0);
        backface-visibility: hidden;
    }

    @keyframes rSpin {
        from { transform: rotateY(0deg); }
        to   { transform: rotateY(360deg); }
    }

    @keyframes bounce-slow {
        0%,
        100% {
            transform: scaleY(1);
        }
        50% {
            transform: scaleY(1.3);
        }
    }

    .animate-bounce-slow {
        animation: bounce-slow 2s ease-in-out infinite;
    }

    @media (max-width: 768px) {
        .release-grid {
            padding-bottom: calc(100vh + 4rem);
        }

        .release-bottom-spacer {
            width: 100%;
            min-height: 20vh;
        }

        .release-card .vinyl-animation {
            opacity: 0.1;
            transform: translateX(0) scale(0.96);
            will-change: transform, opacity;
        }

        .release-card.is-centered .vinyl-animation {
            opacity: 1;
            transform: translateX(8px) scale(1.02);
        }

        .release-card.is-centered .relative.aspect-square > img {
            opacity: 0.7;
        }
    }
</style>
